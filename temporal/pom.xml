<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.agentican</groupId>
        <artifactId>agentican-framework-parent</artifactId>
        <version>0.1.0-alpha.5-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentican-temporal</artifactId>
    <name>Agentican Temporal</name>
    <description>Temporal.io activity wrappers around Agentican's agent and code step boundaries. Use these to call agentican from your own Temporal workflows without taking a dependency on agentican's in-process executor.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <temporal.version>1.27.0</temporal.version>
        <!-- Parent pom's surefire uses @{argLine}; resolve to empty unless something injects a value. -->
        <argLine></argLine>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ai.agentican</groupId>
            <artifactId>agentican-framework-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.temporal</groupId>
            <artifactId>temporal-sdk</artifactId>
            <version>${temporal.version}</version>
        </dependency>
        <dependency>
            <groupId>io.temporal</groupId>
            <artifactId>temporal-testing</artifactId>
            <version>${temporal.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- TestWorkflowEnvironment uses gRPC in-process transport; not pulled in transitively. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <version>1.78.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Parent pom uses @{argLine} which only resolves when something (e.g. JaCoCo)
                         sets the argLine property. Override here so surefire forks cleanly. -->
                    <argLine></argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
